<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>

<body>

<h2>Employee Login</h2>

<% if (error) { %>
    <p><%= error %></p>
<% } %>

<form method="POST" action="/login">

    Email:
    <input type="email" name="email" required>
    <br><br>

    Password:
    <input type="password" name="password" required>
    <br><br>

    <button type="submit">Login</button>

</form>

<a href="/register">Register</a>

</body>
</html>