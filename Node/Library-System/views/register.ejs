<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Register</title>
</head>
<body>
    <h2>Library Member Register</h2>    
    <form method="post" action="/register">
        <input 
        type="text"
        name="name"
        placeholder="name"
        >

        <input 
        type="email"
        name="email"
        placeholder="email"
        >

        <input 
        type="password"
        name="password"
        placeholder="password"
        >

        <button type="submit">Register</button>
    </form>

    <a href="/login">Login</a>
</body>
</html>