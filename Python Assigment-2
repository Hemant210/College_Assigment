Q7. Encapsulation and Inheritance — Bank Account
class Account:
    def __init__(self, name, balance):
        self.name = name
        self.__balance = balance   # Encapsulation

    def deposit(self, amount):
        self.__balance += amount
        print("Deposited:", amount)

    def credit(self, amount):
        if amount <= self.__balance:
            self.__balance -= amount
            print("Credited:", amount)
        else:
            print("Insufficient balance")

    def get_balance(self):
        return self.__balance


class SavingsAccount(Account):
    def interest(self):
        print("Savings account interest is 5%")


class CurrentAccount(Account):
    def interest(self):
        print("Current account interest is 2%")


class Bank:
    def create_account(self, account):
        print("Account created for", account.name)

    def delete_account(self, account):
        print("Account deleted for", account.name)


# Create account
account = SavingsAccount("Rahul", 5000)

bank = Bank()
bank.create_account(account)

account.deposit(2000)
account.credit(1000)

print("Balance:", account.get_balance())

account.interest()

bank.delete_account(account)
Here:

__balance demonstrates encapsulation.

SavingsAccount and CurrentAccount demonstrate inheritance.

deposit() and credit() are account functions.

Bank handles creating and deleting accounts.

Q8. Multiple Inheritance, MRO and C3
class Account:
    def apply_interest(self):
        print("Account interest")


class LoyaltyAccount(Account):
    def apply_interest(self):
        print("Loyalty interest")
        super().apply_interest()


class FeeAccount(Account):
    def apply_interest(self):
        print("Fee account interest")
        super().apply_interest()


class PremiumAccount(LoyaltyAccount, FeeAccount):
    pass


account = PremiumAccount()

account.apply_interest()

print(PremiumAccount.mro())
The MRO is approximately:

PremiumAccount
LoyaltyAccount
FeeAccount
Account
object
So Python follows this order when finding apply_interest().

Q9. Q8 Using Abstract Class
from abc import ABC, abstractmethod


class Account(ABC):

    @abstractmethod
    def apply_interest(self):
        pass


class LoyaltyAccount(Account):
    def apply_interest(self):
        print("Loyalty interest")
        super().apply_interest()


class FeeAccount(Account):
    def apply_interest(self):
        print("Fee account interest")
        super().apply_interest()


class PremiumAccount(LoyaltyAccount, FeeAccount):
    def apply_interest(self):
        print("Premium account interest")
        super().apply_interest()


account = PremiumAccount()
account.apply_interest()

print(PremiumAccount.mro())
ABC makes Account an abstract class, and @abstractmethod defines a method that child classes must implement.

Q10. Interface Using Q9
Python does not have a separate interface keyword like Java. We can create an interface-like structure using Abstract Base Classes.

from abc import ABC, abstractmethod


class Account(ABC):

    @abstractmethod
    def interestRate(self):
        pass

    @abstractmethod
    def apply_interest(self):
        pass


class LoyaltyAccount(Account):

    def interestRate(self):
        return 5

    def apply_interest(self):
        print("Loyalty interest")


class FeeAccount(Account):

    def interestRate(self):
        return 2

    def apply_interest(self):
        print("Fee account interest")


class PremiumAccount(LoyaltyAccount, FeeAccount):

    def interestRate(self):
        return 7

    def apply_interest(self):
        print("Premium interest")


account = PremiumAccount()

print("Interest Rate:", account.interestRate(), "%")
account.apply_interest()

