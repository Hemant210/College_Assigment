Q2. Bus Inherits Vehicle + Setter and Getter
class Vehicle:
    def __init__(self, max_speed, mileage):
        self.max_speed = max_speed
        self.mileage = mileage


class Bus(Vehicle):
    def set_speed(self, speed):
        self.max_speed = speed

    def get_speed(self):
        return self.max_speed

    def set_mileage(self, mileage):
        self.mileage = mileage

    def get_mileage(self):
        return self.mileage


bus = Bus(120, 15)

bus.set_speed(150)
bus.set_mileage(20)

print("Speed:", bus.get_speed())
print("Mileage:", bus.get_mileage())
